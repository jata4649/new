# 開発用イメージ。本番用の multi-stage ビルドは Phase 8（本番化）で別途用意する。
FROM node:22-bookworm-slim

# @node-rs/argon2 と Prisma が必要とする共有ライブラリ
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app

# 依存関係の層をキャッシュする
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Prisma クライアントは schema からの生成物なので、イメージ内で生成する
RUN pnpm exec prisma generate

EXPOSE 3000
CMD ["pnpm", "dev"]
