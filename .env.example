###############################################################################
# 環境変数サンプル
#
#   cp .env.example .env
#
# 【重要】
#  - .env はコミットしない（.gitignore 済み）
#  - 本番相当の秘密情報をこのファイルへ書かない
#  - すべての値は src/lib/config/env.ts で起動時に Zod 検証される。
#    欠落・不正があればアプリは起動せずに落ちる（本番での設定漏れ事故を防ぐため）
###############################################################################

# --- 実行モード -------------------------------------------------------------
NODE_ENV=development

# --- データベース -----------------------------------------------------------
# docker compose up で起動する PostgreSQL に合わせた既定値
DATABASE_URL="postgresql://oripa:oripa_dev_password@localhost:5432/oripa_dev?schema=public"

# prisma migrate dev が使うシャドウ DB（docker-compose の postgres-shadow）
SHADOW_DATABASE_URL="postgresql://oripa:oripa_dev_password@localhost:5433/oripa_shadow?schema=public"

# 本番運用時のみ: アプリはテーブル所有者ではなく権限を絞ったロールで接続する。
# 追記専用テーブル（台帳・監査ログ・抽選履歴）への UPDATE / DELETE 権限を持たない。
#   DATABASE_URL="postgresql://oripa_app:oripa_app_dev_password@localhost:5432/oripa_dev?schema=public"

# --- Redis（レート制限・キャッシュ専用。残高や抽選結果は保存しない） ---------
REDIS_URL="redis://localhost:6379"

# --- 認証 -------------------------------------------------------------------
# 32 文字以上のランダム文字列。生成例: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_openssl_rand_base64_48_で生成した値に置き換えてください"
AUTH_URL="http://localhost:3000"
AUTH_SESSION_MAX_AGE_DAYS=30

# --- サイト公開モード（クローズドテスト運用） -------------------------------
# closed: 全ページに Basic 認証を要求し、noindex を付与する
# public: 一般公開（本 MVP では production での指定を禁止している）
SITE_ACCESS_MODE=closed
SITE_BASIC_AUTH_USER=tester
SITE_BASIC_AUTH_PASSWORD=closed_test_password

# 管理画面を特定 IP に限定する場合（カンマ区切り）。空なら制限しない。
ADMIN_IP_ALLOWLIST=

# --- ポイント ---------------------------------------------------------------
# 有償ポイントの有効期限（日）。
# 180 日（6 か月未満）を超える値は設定できない。
# 6 か月を超えると資金決済法上の前払式支払手段に該当し、届出・供託義務が生じうるため。
POINT_EXPIRY_DAYS_PAID=180
POINT_EXPIRY_DAYS_FREE=180

# 開発・テスト用の有効期限短縮（分）。production では無視される。
# 例: 有効期限切れの挙動を確認したいとき 5 を指定する。
# POINT_EXPIRY_MINUTES_OVERRIDE=5

# 消費順序: free_first（既定） / paid_first / expiry_only
POINT_CONSUMPTION_STRATEGY=free_first

# --- 決済（MVP は mock のみ。現金は一切扱わない） ---------------------------
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET="mock_webhook_secret_dev_only"

# --- アップロード -----------------------------------------------------------
UPLOAD_MAX_BYTES=5242880
UPLOAD_DIR=./storage/uploads

# --- レート制限 -------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# --- 可観測性（Phase 8 で Sentry を接続する） -------------------------------
# SENTRY_DSN=
LOG_LEVEL=info

# --- クライアントへ公開される値（NEXT_PUBLIC_ 接頭辞） ----------------------
NEXT_PUBLIC_SITE_NAME="オリパ（開発用テスト環境）"
NEXT_PUBLIC_TEST_MODE_BANNER=true
